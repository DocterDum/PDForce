{
  "manifest_version": 3,
  "name": "PDForce",
  "version": "1.0.0",
  "description": "Force PDFs to open in the browser viewer or to download, overriding what the site asks for.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "storage"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "PDForce",
    "default_icon": {
      "16": "icons/off-16.png",
      "32": "icons/off-32.png",
      "48": "icons/off-48.png",
      "128": "icons/off-128.png"
    }
  },
  "icons": {
    "16": "icons/store-16.png",
    "32": "icons/store-32.png",
    "48": "icons/store-48.png",
    "128": "icons/store-128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "force_view",
        "enabled": false,
        "path": "rules/force_view.json"
      },
      {
        "id": "force_download",
        "enabled": false,
        "path": "rules/force_download.json"
      }
    ]
  }
}
